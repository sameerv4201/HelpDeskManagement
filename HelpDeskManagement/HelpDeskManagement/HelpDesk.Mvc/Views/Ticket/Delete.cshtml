@model HelpDesk.Mvc.Models.Ticket
@{
    ViewData["Title"] = "Delete Ticket";
}

<h1>Delete Ticket</h1>
<h3 class="text-danger">Are you sure you want to delete this ticket?</h3>

<dl class="row">
    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Priority</dt>
    <dd class="col-sm-10">@Model.Priority</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>

    <dt class="col-sm-2">Raised By</dt>
    <dd class="col-sm-10">@Model.RaisedBy</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-secondary" asp-action="Index">Cancel</a>
</form>
