@model HelpDesk.Mvc.Models.Ticket
@{
    ViewData["Title"] = "Ticket Details";
}

<h1>Ticket Details</h1>

<dl class="row">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">Title</dt>
    <dd class="col-sm-10">@Model.Title</dd>

    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>

    <dt class="col-sm-2">Priority</dt>
    <dd class="col-sm-10">@Model.Priority</dd>

    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>

    <dt class="col-sm-2">Raised By</dt>
    <dd class="col-sm-10">@Model.RaisedBy</dd>

    <dt class="col-sm-2">Created Date</dt>
    <dd class="col-sm-10">@Model.CreatedDate.ToString("g")</dd>
</dl>

<a class="btn btn-secondary" asp-action="Index">Back to List</a>
<a class="btn btn-secondary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
